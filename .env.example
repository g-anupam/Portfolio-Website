# Contact form. Without the first two, the form is hidden and the contact
# section shows links only. Set them in Vercel under Settings > Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=

# Optional sender. The default works without verifying a domain, but only
# delivers to the email address the Resend account was created with.
# CONTACT_FROM_EMAIL="Portfolio <hello@your-domain>"
